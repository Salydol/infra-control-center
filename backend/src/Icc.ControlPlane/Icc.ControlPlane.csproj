<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Icc.ControlPlane</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
  </ItemGroup>

  <!-- Контракты агент–центр: единый источник — папка proto/ в корне репозитория. -->
  <ItemGroup>
    <Protobuf Include="..\..\..\proto\icc\agent\v1\*.proto"
              ProtoRoot="..\..\..\proto"
              GrpcServices="Both"
              Access="Public" />
  </ItemGroup>

</Project>
