{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Urls": "http://0.0.0.0:8080",
  "Database": {
    "Host": "postgres",
    "MaxPoolSize": 30
  },
  "RabbitMq": {
    "Host": "rabbitmq"
  },
  "Catalog": {
    "BaseUrl": "http://catalog:8080",
    "TimeoutMs": 2000,
    "Retries": 2
  },
  "Orders": {
    "MaxQuantity": 10
  }
}
