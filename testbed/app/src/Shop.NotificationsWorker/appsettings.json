{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://0.0.0.0:8080",
  "Database": {
    "Host": "postgres",
    "MaxPoolSize": 10
  },
  "Redis": {
    "Endpoint": "redis:6379"
  },
  "RabbitMq": {
    "Host": "rabbitmq"
  },
  "Notifications": {
    "Prefetch": 20,
    "Concurrency": 2,
    "Channel": "email",
    "SendDelayMs": 30,
    "DedupTtlSeconds": 3600
  }
}
