# Скопируйте в .env.
# Какие узлы запускать на этой машине: все три — для локальной отладки,
# на ВМ стенда — один (node1, node2 или node3).
COMPOSE_PROFILES=node1,node2,node3

# Версии сервисов магазина. Смена версии — это «деплой» для стенда.
API_VERSION=1.0.0
CATALOG_VERSION=1.0.0
PAYMENTS_VERSION=1.0.0
NOTIFICATIONS_VERSION=1.0.0

# Порт шлюза магазина на хосте (цель для k6).
GATEWAY_PORT=8000

# Адреса узлов (только для compose.distributed.yaml).
NODE1_IP=192.168.56.11
NODE2_IP=192.168.56.12
NODE3_IP=192.168.56.13
